# ConsoleHub Environment Config
# Copy to .env and edit before running

# Your NAS IP (nodes need this to push SRT streams)
NAS_IP=192.168.1.100

# Security
JWT_SECRET=change_this_to_something_random
TURN_PASSWORD=change_this_too

# MediaMTX WebRTC port (what browsers connect to)
WEBRTC_PORT=8889

# SRT port (what nodes push streams to)
SRT_PORT=8890
